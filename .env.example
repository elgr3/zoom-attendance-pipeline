# =====================================================================
# Modèle de configuration — pipeline ETL présences Zoom
# Copie ce fichier en `.env` et remplis les valeurs. NE COMMITE JAMAIS `.env`.
# En local :   set -a; source .env; set +a   (bash)   puis   python test_local.py
# Sur GCF   :   passe ces variables via --set-env-vars ou Secret Manager.
# =====================================================================

# --- Zoom : app Server-to-Server OAuth ---
# (Zoom Marketplace > Develop > Build App > Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# --- Zoom : webhook (Feature > Event Subscriptions) ---
# Secret Token utilisé pour la validation d'URL ET la signature x-zm-signature.
ZOOM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_token

# --- SMTP : envoi de l'email de bilan ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
# Gmail : utilise un "App Password" (2FA requis), pas ton mot de passe habituel.
SMTP_PASSWORD=your_app_password
EMAIL_FROM=ton.adresse@gmail.com
# Destinataires multiples séparés par des virgules.
EMAIL_TO=destinataire1@oued.io,destinataire2@oued.io
